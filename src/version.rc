#include <winver.h>
#include "version.h"

1 VERSIONINFO
FILEVERSION PC_CONTROL_VERSION_COMMA
PRODUCTVERSION PC_CONTROL_VERSION_COMMA
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "pc-control MQTT power control\0"
            VALUE "FileVersion", VERSION "\0"
            VALUE "ProductName", "pc-control\0"
            VALUE "ProductVersion", VERSION "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
